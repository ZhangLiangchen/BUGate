# Build outputs and isolated dependencies
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
node_modules/
node_modules
/adapters/deepseek-harness/plugin/lib/
/adapters/deepseek-harness/plugin/resources/
/packages/core/resources/
/adapters/deepseek-harness/plugin/python/
*.tgz

# Existing independent worktrees and local state are never distribution inputs.
/.claude/worktrees/
/.claude/settings.local.json
/.memory_bus/
/.shared/
/.codex/

# Editor and machine-local files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Product facts and credentials belong outside BUGate core.
/sut/
.env
.env.*
**/secrets.*
**/*.secret
*.pem
*.key
id_rsa*
*_keypair*
*mnemonic*

# Temporary output; selected delivery logs are reviewable evidence.
*.log
/artifacts/
/tmp/
*.tmp
*.bak
!docs/reports/v2-dsh-only/evidence/*.log

# Preserve pre-existing local historical outputs; not current product inputs.
/oracle_falsification_result.json
/oracle_falsification_result.md
/prd_health_result.json
/prd_health_report.md
