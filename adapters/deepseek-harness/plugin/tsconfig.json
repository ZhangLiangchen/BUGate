{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noImplicitAny": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": true, "outDir": "lib", "rootDir": "src", "declaration": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"]
}
