{
  "apiVersion": "bugate.io/v2",
  "kind": "MethodSpec",
  "id": "execution",
  "version": "2.1.0-dev.1",
  "objective": "Preserve actual run observations, framework case outcomes and provenance.",
  "quality_dimensions": [
    "execution_provenance",
    "report_consistency",
    "case_traceability"
  ],
  "required_outputs": [
    "Evidence",
    "execution_report"
  ],
  "recommended_considerations": [
    "zero tests",
    "skips and xfails",
    "cancellation",
    "product versus infrastructure failure"
  ],
  "hard_constraint_refs": [
    "core-quality-invariants"
  ]
}
