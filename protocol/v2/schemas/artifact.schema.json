{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugate.io/v2/schemas/artifact.schema.json",
  "title": "BUGate Artifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "bugate.io/v2"
    },
    "kind": {
      "const": "Artifact"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "artifact_type": {
      "enum": [
        "business_brief",
        "testability",
        "inventory",
        "semantic_review",
        "execution_report",
        "knowledge",
        "diagnosis",
        "legacy_precode"
      ]
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "content": {
      "type": "object"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "artifact_type",
    "schema_version",
    "revision",
    "source_refs",
    "relations",
    "content",
    "digest"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "business_brief"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "propositions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "requirement_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "classification": {
                      "enum": [
                        "fact",
                        "inference",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "statement",
                    "source_refs",
                    "requirement_ids",
                    "classification"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "oracles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "proposition_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "expected": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "deadline": {
                      "type": "string",
                      "minLength": 1
                    },
                    "preconditions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "source_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "id",
                    "proposition_ids",
                    "expected",
                    "observation",
                    "deadline",
                    "preconditions",
                    "source_refs"
                  ]
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "propositions",
              "oracles",
              "states",
              "boundaries",
              "unknowns"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "testability"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "decisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "proposition_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "oracle_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "deadline": {
                      "type": "string",
                      "minLength": 1
                    },
                    "preconditions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "layer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "alternatives": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "side_effects": {
                      "type": "string",
                      "minLength": 1
                    },
                    "environment": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "proposition_id",
                    "oracle_id",
                    "observation",
                    "deadline",
                    "preconditions",
                    "layer",
                    "rationale",
                    "alternatives",
                    "side_effects",
                    "environment"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "decisions",
              "gaps"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "inventory"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "proposition_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "oracle_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "risk_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "preconditions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "expected_observations": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "layer": {
                      "enum": [
                        "unit",
                        "component",
                        "integration",
                        "api",
                        "e2e",
                        "static",
                        "probe"
                      ]
                    },
                    "layer_reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "implementation": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "digest": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "path",
                        "digest"
                      ]
                    },
                    "test_selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "negative": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "proposition_ids",
                    "oracle_ids",
                    "risk_ids",
                    "preconditions",
                    "expected_observations",
                    "layer",
                    "layer_reason",
                    "implementation",
                    "test_selector",
                    "negative"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "requirement_scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "risk_scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "cases",
              "requirement_scope",
              "risk_scope"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "semantic_review"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "artifact_digests": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "minProperties": 1
              },
              "conclusion": {
                "enum": [
                  "accepted",
                  "rejected",
                  "uncertain"
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "reasoning": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "source_refs",
              "artifact_digests",
              "conclusion",
              "limitations",
              "reasoning"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "execution_report"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "case_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "outcome": {
                "enum": [
                  "passed",
                  "product_failure",
                  "test_infrastructure_failure",
                  "environment_failure",
                  "cancelled",
                  "blocked"
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "analysis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "evidence_ids",
              "case_ids",
              "outcome",
              "findings",
              "limitations",
              "analysis"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "knowledge"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "draft",
                        "confirmed"
                      ]
                    }
                  },
                  "required": [
                    "statement",
                    "source_refs",
                    "scope",
                    "status"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "entries"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "diagnosis"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "phenomenon": {
                "type": "string",
                "minLength": 1
              },
              "hypotheses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "supporting_evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "contradicting_evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "discriminating_experiment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "hypothesis",
                        "confirmed",
                        "rejected"
                      ]
                    }
                  },
                  "required": [
                    "statement",
                    "supporting_evidence",
                    "contradicting_evidence",
                    "discriminating_experiment",
                    "status"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "phenomenon",
              "hypotheses"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "legacy_precode"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "directory": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "directory"
            ]
          }
        }
      }
    }
  ]
}
