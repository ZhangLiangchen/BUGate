{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugate.io/v2/schemas/evidence.schema.json",
  "title": "BUGate Evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "bugate.io/v2"
    },
    "kind": {
      "const": "Evidence"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_type": {
      "enum": [
        "host_observed",
        "external_import",
        "human_supplied",
        "model_reported"
      ]
    },
    "evidence_type": {
      "enum": [
        "test_execution",
        "runtime_probe",
        "log",
        "review",
        "source_reference",
        "human_input",
        "external_system_result"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "digest"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_task": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "run_id",
        "current_task",
        "limitations"
      ]
    },
    "execution": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "agent_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "call_id": {
              "type": "string",
              "minLength": 1
            },
            "parent_call_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "root_call_id": {
              "type": "string",
              "minLength": 1
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "cwd": {
              "type": "string",
              "minLength": 1
            },
            "started_at": {
              "type": "string",
              "minLength": 1
            },
            "finished_at": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "passed",
                "failed",
                "cancelled",
                "timeout",
                "blocked"
              ]
            },
            "exit_code": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stdout": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "digest"
              ]
            },
            "stderr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "digest"
              ]
            },
            "report": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "digest"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "statistics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tests": {
                  "type": "integer",
                  "minimum": 0
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "skipped": {
                  "type": "integer",
                  "minimum": 0
                },
                "xfail": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "tests",
                "passed",
                "failed",
                "errors",
                "skipped",
                "xfail"
              ]
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outcome": {
                    "enum": [
                      "passed",
                      "failed",
                      "error",
                      "skipped",
                      "xfail"
                    ]
                  }
                },
                "required": [
                  "id",
                  "selector",
                  "outcome"
                ]
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "input_snapshot": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "implementation_digests": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "collector": {
              "const": "bugate.execution/v1"
            },
            "requested_case_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "uniqueItems": true
            },
            "input_manifest": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "minProperties": 1
            },
            "scope_ref": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "revision",
                "digest"
              ]
            },
            "plan_ref": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "digest"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "activity_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "environment_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "run_id",
            "agent_id",
            "session_id",
            "call_id",
            "parent_call_id",
            "root_call_id",
            "argv",
            "cwd",
            "started_at",
            "finished_at",
            "status",
            "exit_code",
            "stdout",
            "stderr",
            "report",
            "statistics",
            "cases",
            "input_snapshot",
            "implementation_digests",
            "collector",
            "requested_case_ids",
            "input_manifest",
            "scope_ref",
            "plan_ref",
            "activity_id",
            "environment_id"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "task_id",
    "workspace_id",
    "source_type",
    "evidence_type",
    "description",
    "references",
    "applicability",
    "execution",
    "digest"
  ]
}
