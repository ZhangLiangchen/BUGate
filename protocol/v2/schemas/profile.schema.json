{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugate.io/v2/schemas/profile.schema.json",
  "title": "BUGate Profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "bugate.io/v2"
    },
    "kind": {
      "const": "Profile"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "digest",
          "description"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "delivery_criteria": {
      "type": "array",
      "items": {
        "enum": [
          "business_understanding",
          "test_design",
          "implementation",
          "execution",
          "report",
          "knowledge"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "report": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "enum": [
              "test",
              "exploration"
            ]
          }
        },
        "required": [
          "argv",
          "case_ids",
          "report",
          "purpose"
        ]
      }
    },
    "resource_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "network",
        "destructive",
        "notes"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "version",
    "sources",
    "requirements",
    "risks",
    "goal",
    "delivery_criteria",
    "resource_boundaries",
    "unknowns"
  ]
}
