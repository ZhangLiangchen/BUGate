{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugate.io/v2/schemas/method_spec.schema.json",
  "title": "BUGate MethodSpec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "bugate.io/v2"
    },
    "kind": {
      "const": "MethodSpec"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "quality_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "recommended_considerations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "hard_constraint_refs": {
      "type": "array",
      "items": {
        "const": "core-quality-invariants"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "version",
    "objective",
    "quality_dimensions",
    "required_outputs",
    "recommended_considerations",
    "hard_constraint_refs"
  ]
}
