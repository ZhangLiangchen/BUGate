{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugate.io/v2/schemas/protocol_binding.schema.json",
  "title": "BUGate ProtocolBinding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "bugate.io/v2"
    },
    "kind": {
      "const": "ProtocolBinding"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ]
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "resolved_from": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "protocol",
    "profile",
    "methods",
    "resolved_from",
    "workspace_id"
  ]
}
