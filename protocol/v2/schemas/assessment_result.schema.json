{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugate.io/v2/schemas/assessment_result.schema.json",
  "title": "BUGate AssessmentResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "bugate.io/v2"
    },
    "kind": {
      "const": "AssessmentResult"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "claim_type": {
      "enum": [
        "business_understanding_complete",
        "test_design_complete",
        "test_implementation_complete",
        "execution_complete",
        "requirement_verified",
        "task_delivery_complete"
      ]
    },
    "claim_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workspace_snapshot": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "satisfied",
        "unsatisfied",
        "inconclusive"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "not_applicable",
                "uncertain"
              ]
            },
            "applicable": {
              "type": "boolean"
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "applicable",
            "basis",
            "limitations"
          ]
        },
        "semantic_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "not_applicable",
                "uncertain"
              ]
            },
            "applicable": {
              "type": "boolean"
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "applicable",
            "basis",
            "limitations"
          ]
        },
        "runtime_validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_run",
                "not_applicable",
                "uncertain"
              ]
            },
            "applicable": {
              "type": "boolean"
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "applicable",
            "basis",
            "limitations"
          ]
        }
      },
      "required": [
        "deterministic",
        "semantic_review",
        "runtime_validation"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "subject",
          "dimension",
          "severity",
          "blocking",
          "message",
          "basis",
          "remediation"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "quality_posture": {
      "enum": [
        "unclaimed",
        "draft",
        "candidate",
        "satisfactory",
        "needs_improvement",
        "incomplete",
        "uncertain"
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "functional_result": {
          "enum": [
            "passed",
            "failed",
            "undetermined",
            "not_assessed"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "blocking_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "suggestion_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "historical_failure_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "coverage_statement": {
          "const": "This conclusion covers only the agreed acceptance scope."
        }
      },
      "required": [
        "execution_complete",
        "functional_result",
        "requirement_ids",
        "blocking_codes",
        "suggestion_ids",
        "historical_failure_ids",
        "coverage_statement"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "id",
    "task_id",
    "workspace_id",
    "claim_id",
    "claim_type",
    "claim_digest",
    "evaluator_version",
    "request_digest",
    "workspace_snapshot",
    "verdict",
    "dimensions",
    "findings",
    "evidence_ids",
    "unknowns",
    "scope",
    "quality_posture",
    "acceptance"
  ]
}
